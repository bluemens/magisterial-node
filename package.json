{
  "name": "magisterial",
  "version": "0.2.0",
  "description": "Official TypeScript/JavaScript SDK for the Magisterial college sports data API",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --target node18 --sourcemap --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sync-types": "./scripts/sync-types.sh",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "magisterial",
    "ncaa",
    "college sports",
    "transfer portal",
    "api",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluemens/magisterial-node.git"
  },
  "homepage": "https://magisterial.ai",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
